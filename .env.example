# 全部可选。不配置也能直接运行。

# 会话签名密钥。留空时首次启动会自动生成并保存到 data/auth-secret。
# AUTH_SECRET=please-change-me

# 数据与文件实体存放位置（支持绝对路径）。
# DATA_DIR=D:/Milktea Cloud Data
# STORAGE_DIR=D:/Milktea Cloud Data/storage

# 是否开放注册（默认 true）。第一个账号始终可以注册。
# ALLOW_REGISTRATION=true

# 单文件上限与每位成员的存储额度（含回收站）。
# MAX_FILE_BYTES=53687091200
# USER_QUOTA_BYTES=107374182400
